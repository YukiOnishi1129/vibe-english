# Copy to .env.local. NEVER commit real values — this repository is public.
# Used by Node tooling: migrations, kysely-codegen, seed, tests.

# --- Database ---------------------------------------------------------------
# Application connection. MUST be a role WITHOUT BYPASSRLS that does NOT own the
# tables, so row level security actually applies. See README "Database roles".
DATABASE_URL=postgres://app:app@localhost:5432/vibe_english?sslmode=disable

# Owner/admin connection, used only by `db:migrate`, `db:codegen` and `db:seed`.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_english?sslmode=disable

# Optional: used by the RLS tests to prove the app role cannot bypass RLS.
APP_DATABASE_URL=postgres://app:app@localhost:5432/vibe_english?sslmode=disable

# --- Cloudflare (deployment only; set as GitHub Secrets, not here) ----------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
